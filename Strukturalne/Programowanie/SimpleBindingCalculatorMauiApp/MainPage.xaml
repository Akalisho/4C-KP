<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SimpleBindingCalculatorMauiApp.MainPage"
             Title="Prosty kalkulator"
             x:Name="thisPage">

    <StackLayout Padding="30,0" Spacing="25">
        <Label Background="#E61B1B"
               BackgroundColor="#F7921B"
               FontAttributes="Bold"
               FontFamily="Arial"
               FontSize="20"
               Text="Podaj pierwszą liczbę:"/>

        <Entry x:Name="firstNumberEntry" Text="{Binding AdditionFirstNumber, Source={x:Reference thisPage}}"/>
        <StackLayout Orientation="Horizontal">
            <Label Text="Podaj drugą liczbę: " VerticalTextAlignment="Center"/>
            <Entry BackgroundColor="Aqua" x:Name="secondNumberEntry" Text="{Binding AdditionSecondNumber, Source={x:Reference thisPage}}"/>
        </StackLayout>
        <Button Text="Oblicz" Clicked="Button_Clicked"/>
        <Label x:Name="resultLabel" Text="{Binding ReturnAddition, Source={x:Reference thisPage}}"/>

    </StackLayout>

</ContentPage>
