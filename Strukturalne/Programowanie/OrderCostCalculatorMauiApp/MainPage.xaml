<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrderCostCalculatorMauiApp.MainPage"
             x:Name="thisPage"
             BindingContext="{x:Reference thisPage}">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Label Text="Nazwa produktu:" />
            <Entry Placeholder="Nazwa produktu:"/>
            <Label Text="Cena za sztukę (zł):" />
            <Entry Placeholder="Cena za sztukę:"/>
            <Stepper Increment="1"
                     Minimum="1"
                     Maximum="10"
                     Value="{Binding LiczbaSztuk}"/>
            <Label Text="{Binding LiczbaSztuk}"/>
            <Switch IsToggled="{Binding CzyEkspresowa}"/>
            <Label Text="Dostawa ekspresowa (+15 zł)" VerticalTextAlignment="Center" />
            <Button Text="Oblicz" Command="{Binding ObliczCommand}"/>
            <Label Text="{Binding Wynik}"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
