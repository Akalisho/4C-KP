<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrderCostCalculatorMauiApp.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Entry Placeholder="Nazwa produktu:" x:Name="nazwaProd"/>
            <Entry Placeholder="Cena za sztukę:" x:Name="cenaSztuk"/>
            <Stepper Increment="1"
                     Minimum="1"
                     Maximum="10"
                     Value="{Binding StepperValue}"/>
            <Label Text="{Binding StepperValue}"/>
            <Switch IsToggled="{Binding IsOn}"/>
            <Button Text="Oblicz" Clicked="Button_Clicked"/>
            <Label Text="{Binding }"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
